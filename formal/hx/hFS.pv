(* SPDX-License-Identifier: AGPL-3.0-or-later *)
(* formal/hx/hFS.pv — session hFS of CLAIMS §HX, one file per session (O-18, ADR-046) over the library
   formal/hx.pvl (model, abstractions, devices: its header). Run: proverif -lib formal/hx.pvl formal/hx/hFS.pv

   Row (formal/hx.pvl 3.): I's inv. pinv and c · PubIKS yes · LeakInv ph 1 · RevealLT(R) ph 1 · RevealLT(I) ph 1 · RevealSPK ph 1 ·
   RevealOPK - · DHO - · KEMO - · layers sealed (O-17).
   Queries (RESULT lines in this order; expected per the CLAIMS gate rule):
     no begin event:    H11 (4) false · H12 (2) true
   — 6 RESULT lines.
*)

const hFS: tagt.

(* Secrecy assumptions (formal/hx.pvl 7.): the keys this session never reveals, and those it reveals only in
   phase 1 (phase 0) *)
not x: bitstring; attacker(dhsk(hFS, eph(x))).
not x: bitstring; attacker(kemsk(hFS, eph(x))).
not attacker(iksig(hFS, pR)) phase 0.
not attacker(dhsk(hFS, kIKR)) phase 0.
not attacker(iksig(hFS, pI)) phase 0.
not attacker(dhsk(hFS, kIKI)) phase 0.
not attacker(dhsk(hFS, kSPK)) phase 0.
not attacker(kemsk(hFS, kSPK)) phase 0.
not attacker(kemsk(hFS, kRPK)) phase 0.

(* Queries (CLAIMS.md §HX), grouped by begin event (O-19); IKSPublic of the honest parties:
   iks(vk(iksig(s, pR)), exp(g, dhsk(s, kIKR))) and iks(vk(iksig(s, pI)), exp(g, dhsk(s, kIKI))). *)

query iI: bitstring, iR: bitstring, b: bitstring, tr: bitstring, rt: bitstring, sk: key, ld: bitstring,
      oid: bitstring, s2: tagt;
      (* H11: reachability sanity: IStart, BundleSigned, the honest pair, IConfirm — IStart *)
      event(IStart(hFS, iks(vk(iksig(hFS, pI)), exp(g, dhsk(hFS, kIKI))),
                   iks(vk(iksig(hFS, pR)), exp(g, dhsk(hFS, kIKR))), b, tr, rt, sk));
      (* H11: BundleSigned *)
      event(BundleSigned(hFS, iR, b));
      (* H11: the honest pair *)
      event(RAccept(hFS, iR, iks(vk(iksig(hFS, pI)), exp(g, dhsk(hFS, kIKI))), ld, oid, tr, rt, sk))
        && event(IStart(hFS, iks(vk(iksig(hFS, pI)), exp(g, dhsk(hFS, kIKI))), iR, b, tr, rt, sk));
      (* H11: IConfirm *)
      event(IConfirm(hFS, iks(vk(iksig(hFS, pI)), exp(g, dhsk(hFS, kIKI))),
                     iks(vk(iksig(hFS, pR)), exp(g, dhsk(hFS, kIKR))), tr, sk));
      (* H12 (i): forward secrecy of SK, I side, iks_R honest *)
      event(IStart(hFS, iI, iks(vk(iksig(hFS, pR)), exp(g, dhsk(hFS, kIKR))), b, tr, rt, sk)) && attacker(sk);
      (* H12 (ii): R side *)
      event(RAccept(hFS, iR, iks(vk(iksig(hFS, pI)), exp(g, dhsk(hFS, kIKI))), ld, oid, tr, rt, sk))
        && attacker(sk).

(* One invitation j issued by R (formal/hx.pvl 1.): OPK_j, bundle, InvitationV1, blob, the one acceptance
   attempt (O-13), and this session's compromise of the invitation *)
let Invitation(s: tagt) =
  new o[]: bitstring;
  new ld[]: bitstring;
  new lk[]: key;
  new opkid[]: bitstring;
  let b = bundle(s, opkid, o) in
  event BundleSigned(s, riks(s), b);
  event InvIssued(s, riks(s), ld, opkid);
  out(c, ld);
  out(c, BlobS(s, ld, lk, b));
  (
    AcceptS(s, ld, lk, opkid, o)
  | out(pinv(s), (ld, lk, fp(riks(s))))
  | (phase 1; Leak(s, ld, lk))
  ).

process
    out(c, riks(hFS))
  | ! Invitation(hFS)
  | ! ProcIS(hFS, pinv(hFS))
  | ! ProcIS(hFS, c)
  | PubI(hFS)
  | (phase 1; RevLT(hFS, pR, kIKR))
  | (phase 1; RevLT(hFS, pI, kIKI))
  | (phase 1; RevSPK(hFS))
