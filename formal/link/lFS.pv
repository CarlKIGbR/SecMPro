(* SPDX-License-Identifier: AGPL-3.0-or-later *)
(* formal/link/lFS.pv — session lFS of CLAIMS §LINK, one file per session (OPEN-M5-16 A, LO-1) over the
   library formal/link.pvl (model, abstractions, devices: its header). Run:
   proverif -lib formal/link.pvl formal/link/lFS.pv

   Row (formal/link.pvl 3.): phase 0: honest links complete; phase 1: RevealStatic, RevealSig.
   Queries in the order of their RESULT lines (CLAIMS §LINK gate rule):
     L5 · L5 · L8 · L8 · L8
   — 5 RESULT lines.
*)

const lFS: tagt.

(* Secrecy assumptions (formal/link.pvl 7.): the secrets this session never reveals, and those it reveals only
   in phase 1 ("phase 0") *)
not x: bitstring; attacker(dhsk(lFS, iC(x))).
not x: bitstring; attacker(kemsk(lFS, iC(x))).
not x: bitstring; attacker(dhsk(lFS, iE(x))).
not x: bitstring; attacker(dhsk(lFS, iR(x))).
not x: bitstring; attacker(kemr(lFS, x)).
not x: bitstring; attacker(sigk(lFS, iQ(x))).
not attacker(dhsk(lFS, kRdh)) phase 0.
not attacker(kemsk(lFS, kRkem)) phase 0.
not attacker(sigk(lFS, kRsig)) phase 0.

(* Queries (CLAIMS §LINK), one declaration per begin event (formal/link.pvl 7.); R's pinned fingerprint is
   h((lbl_relayfp, vk(sigk(s, kRsig)))), an honest queue key vk(sigk(s, iQ(x))). *)

query sid: bitstring, ctr: bitstring, m: bitstring, kid: bitstring, h0: bitstring, h1: bitstring, k1: key,
      k2: key, fp: bitstring, cs: bitstring, cmd: bitstring, x: bitstring;
      (* L5 (c2r): CSend payloads of the links whose CAccept names R's pinned fp *)
      event(CAccept(lFS, h((lbl_relayfp, vk(sigk(lFS, kRsig)))), kid, h0, h1, sid, k1, k2))
        && event(CSend(lFS, sid, ctr, m)) && attacker(m);
      (* L5 (r2c): RSend payloads of the links whose CAccept names R's pinned fp *)
      event(CAccept(lFS, h((lbl_relayfp, vk(sigk(lFS, kRsig)))), kid, h0, h1, sid, k1, k2))
        && event(RSend(lFS, sid, ctr, m)) && attacker(m);
      (* L8: reachability — CStart *)
      event(CStart(lFS, fp, kid, h0));
      (* L8: the honest pair completes (RAccept and CAccept with equal arguments) *)
      event(RAccept(lFS, kid, h0, h1, sid, k1, k2)) && event(CAccept(lFS, fp, kid, h0, h1, sid, k1, k2));
      (* L8: R executes a command of an honest queue key *)
      event(RExec(lFS, sid, cs, cmd, vk(sigk(lFS, iQ(x))))).

process
    Relay(lFS)
  | ! Client(lFS)
  | (phase 1; RevStatic(lFS))
  | (phase 1; RevSig(lFS))
