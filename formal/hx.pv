(* selection devices: do not select the encrypted inputs before the private facts that bind their keys *)
nounif ld: bitstring, lk: key, n: nonce, m: bitstring; attacker(caead_seal(inv_kld(ld, lk), n, (lbl_blob, ld), m)).
nounif ld: bitstring, lk: key, n: nonce, m: bitstring; attacker(caead_seal(hx_kinv(ld, lk), n, (lbl_initcell, ld), m)).

(* ---------------------------------------------------------------- queries (CLAIMS.md §HX, in ID order) ------- *)

(* One declaration (7.). Every query (one RESULT line each) has its "Hk" comment directly above it; the RESULT lines
   appear in this order. IKSPublic of the honest parties of session s: iks(vk(iksig(s,pR)), exp(g, dhsk(s,kIKR)))
   and iks(vk(iksig(s,pI)), exp(g, dhsk(s,kIKI))). *)

query iI: bitstring, iR: bitstring, b: bitstring, tr: bitstring, rt: bitstring, sk: key, ld: bitstring,
      oid: bitstring, s2: tagt;
      (* H1 (i): SK secrecy, classical, I side, iks_R honest (hClean) *)
      event(IStart(hClean, iI, iks(vk(iksig(hClean, pR)), exp(g, dhsk(hClean, kIKR))), b, tr, rt, sk)) && attacker(sk);
      (* H1 (ii): R side, iks_I honest (hClean) *)
      event(RAccept(hClean, iR, iks(vk(iksig(hClean, pI)), exp(g, dhsk(hClean, kIKI))), ld, oid, tr, rt, sk))
        && attacker(sk);
      (* H2 (i): SK secrecy with the DH oracle, I side (hDH) *)
      event(IStart(hDH, iI, iks(vk(iksig(hDH, pR)), exp(g, dhsk(hDH, kIKR))), b, tr, rt, sk)) && attacker(sk);
      (* H2 (ii): R side for matching sessions (hDH) *)
      event(RAccept(hDH, iR, iks(vk(iksig(hDH, pI)), exp(g, dhsk(hDH, kIKI))), ld, oid, tr, rt, sk))
        && event(IStart(hDH, iks(vk(iksig(hDH, pI)), exp(g, dhsk(hDH, kIKI))), iR, b, tr, rt, sk)) && attacker(sk);
      (* H3 (i): SK secrecy with the KEM oracle, I side (hKEM) *)
      event(IStart(hKEM, iI, iks(vk(iksig(hKEM, pR)), exp(g, dhsk(hKEM, kIKR))), b, tr, rt, sk)) && attacker(sk);
      (* H3 (ii): R side, unmatched (hKEM) *)
      event(RAccept(hKEM, iR, iks(vk(iksig(hKEM, pI)), exp(g, dhsk(hKEM, kIKI))), ld, oid, tr, rt, sk))
        && attacker(sk);
      (* H4: sanity, both breaks defeat SK secrecy — as H1 (i) (hBoth); expected false *)
      event(IStart(hBoth, iI, iks(vk(iksig(hBoth, pR)), exp(g, dhsk(hBoth, kIKR))), b, tr, rt, sk)) && attacker(sk);
      (* H5: injective agreement of R with I on transcript, SK and reply route, iks_I honest (hClean) *)
      inj-event(RAccept(hClean, iR, iks(vk(iksig(hClean, pI)), exp(g, dhsk(hClean, kIKI))), ld, oid, tr, rt, sk))
        ==> inj-event(IStart(hClean, iks(vk(iksig(hClean, pI)), exp(g, dhsk(hClean, kIKI))), iR, b, tr, rt, sk));
      (* H5 (hKEM) *)
      inj-event(RAccept(hKEM, iR, iks(vk(iksig(hKEM, pI)), exp(g, dhsk(hKEM, kIKI))), ld, oid, tr, rt, sk))
        ==> inj-event(IStart(hKEM, iks(vk(iksig(hKEM, pI)), exp(g, dhsk(hKEM, kIKI))), iR, b, tr, rt, sk));
      (* H6a: bundle origin authentication, every session without RevealLT(R) before IStart (hClean) *)
      event(IStart(hClean, iI, iks(vk(iksig(hClean, pR)), exp(g, dhsk(hClean, kIKR))), b, tr, rt, sk))
        ==> event(BundleSigned(s2, iks(vk(iksig(hClean, pR)), exp(g, dhsk(hClean, kIKR))), b));
      (* H6a (hDH) *)
      event(IStart(hDH, iI, iks(vk(iksig(hDH, pR)), exp(g, dhsk(hDH, kIKR))), b, tr, rt, sk))
        ==> event(BundleSigned(s2, iks(vk(iksig(hDH, pR)), exp(g, dhsk(hDH, kIKR))), b));
      (* H6a (hKEM) *)
      event(IStart(hKEM, iI, iks(vk(iksig(hKEM, pR)), exp(g, dhsk(hKEM, kIKR))), b, tr, rt, sk))
        ==> event(BundleSigned(s2, iks(vk(iksig(hKEM, pR)), exp(g, dhsk(hKEM, kIKR))), b));
      (* H6a (hBoth) *)
      event(IStart(hBoth, iI, iks(vk(iksig(hBoth, pR)), exp(g, dhsk(hBoth, kIKR))), b, tr, rt, sk))
        ==> event(BundleSigned(s2, iks(vk(iksig(hBoth, pR)), exp(g, dhsk(hBoth, kIKR))), b));
      (* H6a (hId) *)
      event(IStart(hId, iI, iks(vk(iksig(hId, pR)), exp(g, dhsk(hId, kIKR))), b, tr, rt, sk))
        ==> event(BundleSigned(s2, iks(vk(iksig(hId, pR)), exp(g, dhsk(hId, kIKR))), b));
      (* H6a (hIdThief) *)
      event(IStart(hIdThief, iI, iks(vk(iksig(hIdThief, pR)), exp(g, dhsk(hIdThief, kIKR))), b, tr, rt, sk))
        ==> event(BundleSigned(s2, iks(vk(iksig(hIdThief, pR)), exp(g, dhsk(hIdThief, kIKR))), b));
      (* H6a (hIdLater) *)
      event(IStart(hIdLater, iI, iks(vk(iksig(hIdLater, pR)), exp(g, dhsk(hIdLater, kIKR))), b, tr, rt, sk))
        ==> event(BundleSigned(s2, iks(vk(iksig(hIdLater, pR)), exp(g, dhsk(hIdLater, kIKR))), b));
      (* H6a (hIdLaterOPK) *)
      event(IStart(hIdLaterOPK, iI, iks(vk(iksig(hIdLaterOPK, pR)), exp(g, dhsk(hIdLaterOPK, kIKR))), b, tr, rt, sk))
        ==> event(BundleSigned(s2, iks(vk(iksig(hIdLaterOPK, pR)), exp(g, dhsk(hIdLaterOPK, kIKR))), b));
      (* H6a (hKCI) *)
      event(IStart(hKCI, iI, iks(vk(iksig(hKCI, pR)), exp(g, dhsk(hKCI, kIKR))), b, tr, rt, sk))
        ==> event(BundleSigned(s2, iks(vk(iksig(hKCI, pR)), exp(g, dhsk(hKCI, kIKR))), b));
      (* H6a (hKCIi) *)
      event(IStart(hKCIi, iI, iks(vk(iksig(hKCIi, pR)), exp(g, dhsk(hKCIi, kIKR))), b, tr, rt, sk))
        ==> event(BundleSigned(s2, iks(vk(iksig(hKCIi, pR)), exp(g, dhsk(hKCIi, kIKR))), b));
      (* H6a (hFS) *)
      event(IStart(hFS, iI, iks(vk(iksig(hFS, pR)), exp(g, dhsk(hFS, kIKR))), b, tr, rt, sk))
        ==> event(BundleSigned(s2, iks(vk(iksig(hFS, pR)), exp(g, dhsk(hFS, kIKR))), b));
      (* H6a (hFSOPK) *)
      event(IStart(hFSOPK, iI, iks(vk(iksig(hFSOPK, pR)), exp(g, dhsk(hFSOPK, kIKR))), b, tr, rt, sk))
        ==> event(BundleSigned(s2, iks(vk(iksig(hFSOPK, pR)), exp(g, dhsk(hFSOPK, kIKR))), b));
      (* H6a (hFSDH) *)
      event(IStart(hFSDH, iI, iks(vk(iksig(hFSDH, pR)), exp(g, dhsk(hFSDH, kIKR))), b, tr, rt, sk))
        ==> event(BundleSigned(s2, iks(vk(iksig(hFSDH, pR)), exp(g, dhsk(hFSDH, kIKR))), b));
      (* H6b: key confirmation at I's first decrypted reply, iks_R honest (hClean) *)
      inj-event(IConfirm(hClean, iI, iks(vk(iksig(hClean, pR)), exp(g, dhsk(hClean, kIKR))), tr, sk))
        ==> inj-event(RAccept(hClean, iks(vk(iksig(hClean, pR)), exp(g, dhsk(hClean, kIKR))), iI, ld, oid, tr, rt, sk));
      (* H7a: identity confidentiality of I, network attacker / relay — IK_dh_I public key (hId) *)
      attacker(exp(g, dhsk(hId, kIKI)));
      (* H7a: IK_sig_I public key (hId) *)
      attacker(vk(iksig(hId, pI)));
      (* H7b: against an invitation thief (hIdThief) *)
      attacker(exp(g, dhsk(hIdThief, kIKI)));
      (* H7b *)
      attacker(vk(iksig(hIdThief, pI)));
      (* H7c: against a later invitation leak (hIdLater) *)
      attacker(exp(g, dhsk(hIdLater, kIKI)));
      (* H7c *)
      attacker(vk(iksig(hIdLater, pI)));
      (* H7d: sanity, K_id falls with the OPK (hIdLaterOPK); expected false *)
      attacker(exp(g, dhsk(hIdLaterOPK, kIKI)));
      (* H7d *)
      attacker(vk(iksig(hIdLaterOPK, pI)));
      (* H8: expected false — PQ-only authentication of I to R: H5's correspondence (hDH) *)
      inj-event(RAccept(hDH, iR, iks(vk(iksig(hDH, pI)), exp(g, dhsk(hDH, kIKI))), ld, oid, tr, rt, sk))
        ==> inj-event(IStart(hDH, iks(vk(iksig(hDH, pI)), exp(g, dhsk(hDH, kIKI))), iR, b, tr, rt, sk));
      (* H9: expected false — KCI with R's signed-prekey secret: H5's correspondence (hKCI) *)
      inj-event(RAccept(hKCI, iR, iks(vk(iksig(hKCI, pI)), exp(g, dhsk(hKCI, kIKI))), ld, oid, tr, rt, sk))
        ==> inj-event(IStart(hKCI, iks(vk(iksig(hKCI, pI)), exp(g, dhsk(hKCI, kIKI))), iR, b, tr, rt, sk));
      (* H9b: boundary, R's identity keys alone give no KCI: H5's correspondence (hKCIlt) *)
      inj-event(RAccept(hKCIlt, iR, iks(vk(iksig(hKCIlt, pI)), exp(g, dhsk(hKCIlt, kIKI))), ld, oid, tr, rt, sk))
        ==> inj-event(IStart(hKCIlt, iks(vk(iksig(hKCIlt, pI)), exp(g, dhsk(hKCIlt, kIKI))), iR, b, tr, rt, sk));
      (* H9c: I's identity keys do not expose I's SK: H1 (i) (hKCIi) *)
      event(IStart(hKCIi, iI, iks(vk(iksig(hKCIi, pR)), exp(g, dhsk(hKCIi, kIKR))), b, tr, rt, sk)) && attacker(sk);
      (* H10: OPK single use, replayed envelope not accepted (hClean) *)
      inj-event(RAccept(hClean, iR, iI, ld, oid, tr, rt, sk)) ==> inj-event(InvIssued(hClean, iR, ld, oid));
      (* H11: reachability sanity, per session: IStart, BundleSigned, the honest pair, IConfirm (hClean) *)
      event(IStart(hClean, iks(vk(iksig(hClean, pI)), exp(g, dhsk(hClean, kIKI))),
                   iks(vk(iksig(hClean, pR)), exp(g, dhsk(hClean, kIKR))), b, tr, rt, sk));
      (* H11 *)
      event(BundleSigned(hClean, iR, b));
      (* H11 *)
      event(RAccept(hClean, iR, iks(vk(iksig(hClean, pI)), exp(g, dhsk(hClean, kIKI))), ld, oid, tr, rt, sk))
        && event(IStart(hClean, iks(vk(iksig(hClean, pI)), exp(g, dhsk(hClean, kIKI))), iR, b, tr, rt, sk));
      (* H11 *)
      event(IConfirm(hClean, iks(vk(iksig(hClean, pI)), exp(g, dhsk(hClean, kIKI))),
                     iks(vk(iksig(hClean, pR)), exp(g, dhsk(hClean, kIKR))), tr, sk));
      (* H11 (hDH) *)
      event(IStart(hDH, iks(vk(iksig(hDH, pI)), exp(g, dhsk(hDH, kIKI))),
                   iks(vk(iksig(hDH, pR)), exp(g, dhsk(hDH, kIKR))), b, tr, rt, sk));
      (* H11 *)
      event(BundleSigned(hDH, iR, b));
      (* H11 *)
      event(RAccept(hDH, iR, iks(vk(iksig(hDH, pI)), exp(g, dhsk(hDH, kIKI))), ld, oid, tr, rt, sk))
        && event(IStart(hDH, iks(vk(iksig(hDH, pI)), exp(g, dhsk(hDH, kIKI))), iR, b, tr, rt, sk));
      (* H11 *)
      event(IConfirm(hDH, iks(vk(iksig(hDH, pI)), exp(g, dhsk(hDH, kIKI))),
                     iks(vk(iksig(hDH, pR)), exp(g, dhsk(hDH, kIKR))), tr, sk));
      (* H11 (hKEM) *)
      event(IStart(hKEM, iks(vk(iksig(hKEM, pI)), exp(g, dhsk(hKEM, kIKI))),
                   iks(vk(iksig(hKEM, pR)), exp(g, dhsk(hKEM, kIKR))), b, tr, rt, sk));
      (* H11 *)
      event(BundleSigned(hKEM, iR, b));
      (* H11 *)
      event(RAccept(hKEM, iR, iks(vk(iksig(hKEM, pI)), exp(g, dhsk(hKEM, kIKI))), ld, oid, tr, rt, sk))
        && event(IStart(hKEM, iks(vk(iksig(hKEM, pI)), exp(g, dhsk(hKEM, kIKI))), iR, b, tr, rt, sk));
      (* H11 *)
      event(IConfirm(hKEM, iks(vk(iksig(hKEM, pI)), exp(g, dhsk(hKEM, kIKI))),
                     iks(vk(iksig(hKEM, pR)), exp(g, dhsk(hKEM, kIKR))), tr, sk));
      (* H11 (hBoth) *)
      event(IStart(hBoth, iks(vk(iksig(hBoth, pI)), exp(g, dhsk(hBoth, kIKI))),
                   iks(vk(iksig(hBoth, pR)), exp(g, dhsk(hBoth, kIKR))), b, tr, rt, sk));
      (* H11 *)
      event(BundleSigned(hBoth, iR, b));
      (* H11 *)
      event(RAccept(hBoth, iR, iks(vk(iksig(hBoth, pI)), exp(g, dhsk(hBoth, kIKI))), ld, oid, tr, rt, sk))
        && event(IStart(hBoth, iks(vk(iksig(hBoth, pI)), exp(g, dhsk(hBoth, kIKI))), iR, b, tr, rt, sk));
      (* H11 *)
      event(IConfirm(hBoth, iks(vk(iksig(hBoth, pI)), exp(g, dhsk(hBoth, kIKI))),
                     iks(vk(iksig(hBoth, pR)), exp(g, dhsk(hBoth, kIKR))), tr, sk));
      (* H11 (hId) *)
      event(IStart(hId, iks(vk(iksig(hId, pI)), exp(g, dhsk(hId, kIKI))),
                   iks(vk(iksig(hId, pR)), exp(g, dhsk(hId, kIKR))), b, tr, rt, sk));
      (* H11 *)
      event(BundleSigned(hId, iR, b));
      (* H11 *)
      event(RAccept(hId, iR, iks(vk(iksig(hId, pI)), exp(g, dhsk(hId, kIKI))), ld, oid, tr, rt, sk))
        && event(IStart(hId, iks(vk(iksig(hId, pI)), exp(g, dhsk(hId, kIKI))), iR, b, tr, rt, sk));
      (* H11 *)
      event(IConfirm(hId, iks(vk(iksig(hId, pI)), exp(g, dhsk(hId, kIKI))),
                     iks(vk(iksig(hId, pR)), exp(g, dhsk(hId, kIKR))), tr, sk));
      (* H11 (hIdThief) *)
      event(IStart(hIdThief, iks(vk(iksig(hIdThief, pI)), exp(g, dhsk(hIdThief, kIKI))),
                   iks(vk(iksig(hIdThief, pR)), exp(g, dhsk(hIdThief, kIKR))), b, tr, rt, sk));
      (* H11 *)
      event(BundleSigned(hIdThief, iR, b));
      (* H11 *)
      event(RAccept(hIdThief, iR, iks(vk(iksig(hIdThief, pI)), exp(g, dhsk(hIdThief, kIKI))), ld, oid, tr, rt, sk))
        && event(IStart(hIdThief, iks(vk(iksig(hIdThief, pI)), exp(g, dhsk(hIdThief, kIKI))), iR, b, tr, rt, sk));
      (* H11 *)
      event(IConfirm(hIdThief, iks(vk(iksig(hIdThief, pI)), exp(g, dhsk(hIdThief, kIKI))),
                     iks(vk(iksig(hIdThief, pR)), exp(g, dhsk(hIdThief, kIKR))), tr, sk));
      (* H11 (hIdLater) *)
      event(IStart(hIdLater, iks(vk(iksig(hIdLater, pI)), exp(g, dhsk(hIdLater, kIKI))),
                   iks(vk(iksig(hIdLater, pR)), exp(g, dhsk(hIdLater, kIKR))), b, tr, rt, sk));
      (* H11 *)
      event(BundleSigned(hIdLater, iR, b));
      (* H11 *)
      event(RAccept(hIdLater, iR, iks(vk(iksig(hIdLater, pI)), exp(g, dhsk(hIdLater, kIKI))), ld, oid, tr, rt, sk))
        && event(IStart(hIdLater, iks(vk(iksig(hIdLater, pI)), exp(g, dhsk(hIdLater, kIKI))), iR, b, tr, rt, sk));
      (* H11 *)
      event(IConfirm(hIdLater, iks(vk(iksig(hIdLater, pI)), exp(g, dhsk(hIdLater, kIKI))),
                     iks(vk(iksig(hIdLater, pR)), exp(g, dhsk(hIdLater, kIKR))), tr, sk));
      (* H11 (hIdLaterOPK) *)
      event(IStart(hIdLaterOPK, iks(vk(iksig(hIdLaterOPK, pI)), exp(g, dhsk(hIdLaterOPK, kIKI))),
                   iks(vk(iksig(hIdLaterOPK, pR)), exp(g, dhsk(hIdLaterOPK, kIKR))), b, tr, rt, sk));
      (* H11 *)
      event(BundleSigned(hIdLaterOPK, iR, b));
      (* H11 *)
      event(RAccept(hIdLaterOPK, iR, iks(vk(iksig(hIdLaterOPK, pI)), exp(g, dhsk(hIdLaterOPK, kIKI))), ld, oid, tr,
                    rt, sk))
        && event(IStart(hIdLaterOPK, iks(vk(iksig(hIdLaterOPK, pI)), exp(g, dhsk(hIdLaterOPK, kIKI))), iR, b, tr, rt,
                        sk));
      (* H11 *)
      event(IConfirm(hIdLaterOPK, iks(vk(iksig(hIdLaterOPK, pI)), exp(g, dhsk(hIdLaterOPK, kIKI))),
                     iks(vk(iksig(hIdLaterOPK, pR)), exp(g, dhsk(hIdLaterOPK, kIKR))), tr, sk));
      (* H11 (hKCI) *)
      event(IStart(hKCI, iks(vk(iksig(hKCI, pI)), exp(g, dhsk(hKCI, kIKI))),
                   iks(vk(iksig(hKCI, pR)), exp(g, dhsk(hKCI, kIKR))), b, tr, rt, sk));
      (* H11 *)
      event(BundleSigned(hKCI, iR, b));
      (* H11 *)
      event(RAccept(hKCI, iR, iks(vk(iksig(hKCI, pI)), exp(g, dhsk(hKCI, kIKI))), ld, oid, tr, rt, sk))
        && event(IStart(hKCI, iks(vk(iksig(hKCI, pI)), exp(g, dhsk(hKCI, kIKI))), iR, b, tr, rt, sk));
      (* H11 *)
      event(IConfirm(hKCI, iks(vk(iksig(hKCI, pI)), exp(g, dhsk(hKCI, kIKI))),
                     iks(vk(iksig(hKCI, pR)), exp(g, dhsk(hKCI, kIKR))), tr, sk));
      (* H11 (hKCIlt) *)
      event(IStart(hKCIlt, iks(vk(iksig(hKCIlt, pI)), exp(g, dhsk(hKCIlt, kIKI))),
                   iks(vk(iksig(hKCIlt, pR)), exp(g, dhsk(hKCIlt, kIKR))), b, tr, rt, sk));
      (* H11 *)
      event(BundleSigned(hKCIlt, iR, b));
      (* H11 *)
      event(RAccept(hKCIlt, iR, iks(vk(iksig(hKCIlt, pI)), exp(g, dhsk(hKCIlt, kIKI))), ld, oid, tr, rt, sk))
        && event(IStart(hKCIlt, iks(vk(iksig(hKCIlt, pI)), exp(g, dhsk(hKCIlt, kIKI))), iR, b, tr, rt, sk));
      (* H11 *)
      event(IConfirm(hKCIlt, iks(vk(iksig(hKCIlt, pI)), exp(g, dhsk(hKCIlt, kIKI))),
                     iks(vk(iksig(hKCIlt, pR)), exp(g, dhsk(hKCIlt, kIKR))), tr, sk));
      (* H11 (hKCIi) *)
      event(IStart(hKCIi, iks(vk(iksig(hKCIi, pI)), exp(g, dhsk(hKCIi, kIKI))),
                   iks(vk(iksig(hKCIi, pR)), exp(g, dhsk(hKCIi, kIKR))), b, tr, rt, sk));
      (* H11 *)
      event(BundleSigned(hKCIi, iR, b));
      (* H11 *)
      event(RAccept(hKCIi, iR, iks(vk(iksig(hKCIi, pI)), exp(g, dhsk(hKCIi, kIKI))), ld, oid, tr, rt, sk))
        && event(IStart(hKCIi, iks(vk(iksig(hKCIi, pI)), exp(g, dhsk(hKCIi, kIKI))), iR, b, tr, rt, sk));
      (* H11 *)
      event(IConfirm(hKCIi, iks(vk(iksig(hKCIi, pI)), exp(g, dhsk(hKCIi, kIKI))),
                     iks(vk(iksig(hKCIi, pR)), exp(g, dhsk(hKCIi, kIKR))), tr, sk));
      (* H11 (hFS) *)
      event(IStart(hFS, iks(vk(iksig(hFS, pI)), exp(g, dhsk(hFS, kIKI))),
                   iks(vk(iksig(hFS, pR)), exp(g, dhsk(hFS, kIKR))), b, tr, rt, sk));
      (* H11 *)
      event(BundleSigned(hFS, iR, b));
      (* H11 *)
      event(RAccept(hFS, iR, iks(vk(iksig(hFS, pI)), exp(g, dhsk(hFS, kIKI))), ld, oid, tr, rt, sk))
        && event(IStart(hFS, iks(vk(iksig(hFS, pI)), exp(g, dhsk(hFS, kIKI))), iR, b, tr, rt, sk));
      (* H11 *)
      event(IConfirm(hFS, iks(vk(iksig(hFS, pI)), exp(g, dhsk(hFS, kIKI))),
                     iks(vk(iksig(hFS, pR)), exp(g, dhsk(hFS, kIKR))), tr, sk));
      (* H11 (hFSOPK) *)
      event(IStart(hFSOPK, iks(vk(iksig(hFSOPK, pI)), exp(g, dhsk(hFSOPK, kIKI))),
                   iks(vk(iksig(hFSOPK, pR)), exp(g, dhsk(hFSOPK, kIKR))), b, tr, rt, sk));
      (* H11 *)
      event(BundleSigned(hFSOPK, iR, b));
      (* H11 *)
      event(RAccept(hFSOPK, iR, iks(vk(iksig(hFSOPK, pI)), exp(g, dhsk(hFSOPK, kIKI))), ld, oid, tr, rt, sk))
        && event(IStart(hFSOPK, iks(vk(iksig(hFSOPK, pI)), exp(g, dhsk(hFSOPK, kIKI))), iR, b, tr, rt, sk));
      (* H11 *)
      event(IConfirm(hFSOPK, iks(vk(iksig(hFSOPK, pI)), exp(g, dhsk(hFSOPK, kIKI))),
                     iks(vk(iksig(hFSOPK, pR)), exp(g, dhsk(hFSOPK, kIKR))), tr, sk));
      (* H11 (hFSDH) *)
      event(IStart(hFSDH, iks(vk(iksig(hFSDH, pI)), exp(g, dhsk(hFSDH, kIKI))),
                   iks(vk(iksig(hFSDH, pR)), exp(g, dhsk(hFSDH, kIKR))), b, tr, rt, sk));
      (* H11 *)
      event(BundleSigned(hFSDH, iR, b));
      (* H11 *)
      event(RAccept(hFSDH, iR, iks(vk(iksig(hFSDH, pI)), exp(g, dhsk(hFSDH, kIKI))), ld, oid, tr, rt, sk))
        && event(IStart(hFSDH, iks(vk(iksig(hFSDH, pI)), exp(g, dhsk(hFSDH, kIKI))), iR, b, tr, rt, sk));
      (* H11 *)
      event(IConfirm(hFSDH, iks(vk(iksig(hFSDH, pI)), exp(g, dhsk(hFSDH, kIKI))),
                     iks(vk(iksig(hFSDH, pR)), exp(g, dhsk(hFSDH, kIKR))), tr, sk));
      (* H12: forward secrecy of SK, I side (hFS) *)
      event(IStart(hFS, iI, iks(vk(iksig(hFS, pR)), exp(g, dhsk(hFS, kIKR))), b, tr, rt, sk)) && attacker(sk);
      (* H12: R side *)
      event(RAccept(hFS, iR, iks(vk(iksig(hFS, pI)), exp(g, dhsk(hFS, kIKI))), ld, oid, tr, rt, sk)) && attacker(sk);
      (* H12b: sanity, FS rests on OPK deletion (hFSOPK); expected false *)
      event(IStart(hFSOPK, iI, iks(vk(iksig(hFSOPK, pR)), exp(g, dhsk(hFSOPK, kIKR))), b, tr, rt, sk))
        && attacker(sk);
      (* H12b *)
      event(RAccept(hFSOPK, iR, iks(vk(iksig(hFSOPK, pI)), exp(g, dhsk(hFSOPK, kIKI))), ld, oid, tr, rt, sk))
        && attacker(sk);
      (* H12c: FS under a later classical break (hFSDH) *)
      event(IStart(hFSDH, iI, iks(vk(iksig(hFSDH, pR)), exp(g, dhsk(hFSDH, kIKR))), b, tr, rt, sk)) && attacker(sk);
      (* H12c *)
      event(RAccept(hFSDH, iR, iks(vk(iksig(hFSDH, pI)), exp(g, dhsk(hFSDH, kIKI))), ld, oid, tr, rt, sk))
        && attacker(sk).

(* ---------------------------------------------------------------- processes --------------------------------- *)

(* §7.3 Encrypt at chain position given by ck: the cell hdr_nonce ‖ hdr_ct ‖ body *)
letfun mkcell(hk: key, ck: key, sb: bitstring, header: bitstring, m: bitstring) =
  new nn[]: nonce;
  let hc = hseal(hk, nn, (lbl_hdr, sb), header) in
  (nn, hc, bseal(ck_mk(ck), (lbl_body, sb, nn, hc), m)).

(* §6.6 steps 1–3 for one invitation (ld, lk, opkid, OPK secrets osk/odk) on the cells cl0, cl1, cl2. Fails on any
   rejection; on success returns (IKSPublic_I, transcript, rt, SK, dh_pk and ek_pq of first_msg, rk after the
   receiving half of DHRatchet, NHK_B). *)
letfun accept13(iksR: bitstring, ikR: exponent, spk: exponent, spkdh: G, spkkem: bitstring, dkS: kemdk,
                rpkkem: bitstring, dkR: kemdk, ld: bitstring, lk: key, opkid: bitstring, opkdh: G,
                opkkem: bitstring, osk: exponent, odk: kemdk, cl0: bitstring, cl1: bitstring, cl2: bitstring) =
  (* step 1: the three chunks under K_inv (same init_id, i = 0, 1, 2, total = 3), Outer, spk_id/opk_id *)
  let kinv = hx_kinv(ld, lk) in
  let (n0: nonce, x0: bitstring) = cl0 in
  let (iid: bitstring, =i0, =t3, ch0: bitstring) = caead_open(kinv, n0, (lbl_initcell, ld), x0) in
  let (n1: nonce, x1: bitstring) = cl1 in
  let (=iid, =i1, =t3, ch1: bitstring) = caead_open(kinv, n1, (lbl_initcell, ld), x1) in
  let (n2: nonce, x2: bitstring) = cl2 in
  let (=iid, =i2, =t3, ch2: bitstring) = caead_open(kinv, n2, (lbl_initcell, ld), x2) in
  let (ek: G, =spkid0, =opkid, ctspk: bitstring, ctopk: bitstring, nin: nonce, xin: bitstring) = join(ch0, ch1, ch2) in
  (* step 2: DH3, DH4, ss_spk, ss_opk -> K_id; inner_ct -> IKSPublic_I ‖ first_msg *)
  let dh3 = exp(ek, spk) in
  let dh4 = exp(ek, osk) in
  let ssspk = decaps1024(dkS, ctspk) in
  let ssopk = decaps1024(odk, ctopk) in
  let kid = hx_kid(ld, lk, dh3, ssspk, dh4, ssopk) in
  let (iksI: bitstring, (fn: nonce, fhc: bitstring, fbd: bitstring)) = caead_open(kid, nin, (lbl_inner, ld), xin) in
  let iks(vkI: bitstring, ikdhI: G) = iksI in
  (* step 3: DH1, DH2, transcript, SK; §7.2 responder; first_msg on the §7.4 step path (nhk_r = HK_A) *)
  let dh1 = exp(ikdhI, spk) in
  let dh2 = exp(ek, ikR) in
  let tr = th(iksR, spkid0, spkdh, h(spkkem), h(rpkkem), opkid, opkdh, h(opkkem), iksI, ek, h(ctspk), h(ctopk), ld) in
  let sk = hx_sk(dh1, dh2, dh3, dh4, ssspk, ssopk, tr) in
  let rk0 = init_rk(sk) in
  let (dhpk: G, =c0, =c0, ekpq: bitstring, ctpq: bitstring) = hopen(init_hka(sk), fn, (lbl_hdr, tr), fhc) in
  let ssr = decaps768(dkR, ctpq) in
  let dhr = exp(dhpk, spk) in
  let rk1 = rk_rk(rk0, dhr, ssr) in
  let ckr1 = rk_ck(rk0, dhr, ssr) in
  let (=ctHS, rt: bitstring) = bopen(ck_mk(ckr1), (lbl_body, tr, fn, fhc), fbd) in
  (iksI, tr, rt, sk, dhpk, ekpq, rk1, init_nhkb(sk)).

(* One acceptance attempt of R for one invitation (ld, lk, opk_id): the cells, then the single-use OPK cell (6.) *)
let Attempt(s: tagt, iksR: bitstring, ikR: exponent, spk: exponent, spkdh: G, spkkem: bitstring, dkS: kemdk,
            rpkkem: bitstring, dkR: kemdk, ld: bitstring, lk: key, opkid: bitstring, osk: exponent, opkdh: G,
            odk: kemdk, opkkem: bitstring, ocell: channel) =
  in(c, (cl0: bitstring, cl1: bitstring, cl2: bitstring));
  (* the cell only ever holds this invitation's OPK; the equality patterns always match (7.) *)
  in(ocell, (=osk, =odk));
  let (iksI: bitstring, tr: bitstring, rt: bitstring, sk: key, dhpk: G, ekpq: bitstring, rk1: key, nhkb: key) =
    accept13(iksR, ikR, spk, spkdh, spkkem, dkS, rpkkem, dkR, ld, lk, opkid, opkdh, opkkem, osk, odk, cl0, cl1, cl2) in
    event RAccept(s, iksR, iksI, ld, opkid, tr, rt, sk);
    (* §6.6 step 4: the OPK cell is not re-output (deleted). First reply: DHRatchet sending half (fresh dh_s, kem_s;
       Encaps(kem_r = ek_pq)); §7.3 under hk_s = NHK_B, pn = 0, n = 0 *)
    new bb[]: bitstring;
    new rr[]: bitstring;
    let bsk = dhsk(s, eph(bb)) in
    let bdk = kemsk(s, eph(bb)) in
    let ct2 = encaps_ct768(ekpq, kemr(s, rr)) in
    let ss2 = encaps_ss768(ekpq, kemr(s, rr)) in
    let dh2 = exp(dhpk, bsk) in
    let cks2 = rk_ck(rk1, dh2, ss2) in
    new reply[]: bitstring;
    out(c, mkcell(nhkb, cks2, tr, (exp(g, bsk), c0, c0, pk768(bdk), ct2), (ctReply, reply)))
  else
    (* §6.6 step 3: on any failure keep the OPK *)
    out(ocell, (osk, odk)).

(* One invitation j issued by R: OPK_j, bundle, InvitationV1, blob, the OPK cell, the acceptance attempts *)
let Invitation(s: tagt, leak: bitstring, ropk: bitstring, skR: sigsk, ikR: exponent, iksR: bitstring, spk: exponent,
               spkdh: G, spkkem: bitstring, dkS: kemdk, rpkkem: bitstring, dkR: kemdk) =
  new o[]: bitstring;
  new ld[]: bitstring;
  new lk[]: key;
  new opkid[]: bitstring;
  let osk = dhsk(s, eph(o)) in
  let opkdh = exp(g, osk) in
  let odk = kemsk(s, eph(o)) in
  let opkkem = pk1024(odk) in
  (* §6.3 bundle and signature (all preceding fields ‖ ik_dh) *)
  let b = (spkid0, spkdh, spkkem, rpkkem, spkexp0, opk1, opkid, opkdh, opkkem) in
  let sig = hsign(skR, lbl_bundle, (b, exp(g, ikR))) in
  event BundleSigned(s, iksR, b);
  event InvIssued(s, iksR, ld, opkid);
  (* §5.2 invitation; §5.4 blob *)
  let inv = (ld, lk, fp(iksR)) in
  new nb[]: nonce;
  out(c, ld);
  out(c, (nb, caead_seal(inv_kld(ld, lk), nb, (lbl_blob, ld), (iksR, b, sig, profR, created0))));
  new ocell[]: channel;
  (
    out(pinv(s), inv)
  | (if leak = ph0 then (event LeakInv(s, ld); out(c, inv)))
  | (if leak = ph1 then (phase 1; event LeakInv(s, ld); out(c, inv)))
  | (if ropk = ph1 then (phase 1; event RevealOPK(s, pR, ld); out(c, (osk, odk))))
  | out(ocell, (osk, odk))
  | ! Attempt(s, iksR, ikR, spk, spkdh, spkkem, dkS, rpkkem, dkR, ld, lk, opkid, osk, opkdh, odk, opkkem, ocell)
  ).

(* Responder R (inviter) of session s; leak, ropk: phase of LeakInv / RevealOPK (never, ph0, ph1) *)
let ProcR(s: tagt, leak: bitstring, ropk: bitstring) =
  let skR = iksig(s, pR) in
  let ikR = dhsk(s, kIKR) in
  let iksR = iks(vk(skR), exp(g, ikR)) in
  let spk = dhsk(s, kSPK) in
  let spkdh = exp(g, spk) in
  let dkS = kemsk(s, kSPK) in
  let spkkem = pk1024(dkS) in
  let dkR = kemsk(s, kRPK) in
  let rpkkem = pk768(dkR) in
  out(c, iksR);
  ! Invitation(s, leak, ropk, skR, ikR, iksR, spk, spkdh, spkkem, dkS, rpkkem, dkR).

(* Initiator I (invitee) of session s; ich: where I takes invitations from (pinv(s), or c: the attacker as inviter) *)
let ProcI(s: tagt, ich: channel) =
  let skI = iksig(s, pI) in
  let ikI = dhsk(s, kIKI) in
  let iksI = iks(vk(skI), exp(g, ikI)) in
  (* §5.5 step 1: the invitation; step 2: a blob, opened under K_ld *)
  in(ich, (ld: bitstring, lk: key, fpR: bitstring));
  in(c, (nb: nonce, xb: bitstring));
  let (iksR: bitstring, b: bitstring, sig: bitstring, profx: bitstring, createdx: bitstring) =
    caead_open(inv_kld(ld, lk), nb, (lbl_blob, ld), xb) in
  (* step 3: fingerprint pin; step 4: bundle signature, opk_present *)
  if fp(iksR) = fpR then
  let iks(vkR: bitstring, ikdhR: G) = iksR in
  let (spkid: bitstring, spkdh: G, spkkem: bitstring, rpkkem: bitstring, spkexp: bitstring, =opk1, opkid: bitstring,
       opkdh: G, opkkem: bitstring) = b in
  if hverify(vkR, lbl_bundle, (b, ikdhR), sig) = true then
  (* §6.4 *)
  new e[]: bitstring;
  new r1[]: bitstring;
  new r2[]: bitstring;
  let ek = dhsk(s, eph(e)) in
  let ekpub = exp(g, ek) in
  let dh1 = exp(spkdh, ikI) in
  let dh2 = exp(ikdhR, ek) in
  let dh3 = exp(spkdh, ek) in
  let dh4 = exp(opkdh, ek) in
  let ctspk = encaps_ct1024(spkkem, kemr(s, r1)) in
  let ssspk = encaps_ss1024(spkkem, kemr(s, r1)) in
  let ctopk = encaps_ct1024(opkkem, kemr(s, r2)) in
  let ssopk = encaps_ss1024(opkkem, kemr(s, r2)) in
  let tr = th(iksR, spkid, spkdh, h(spkkem), h(rpkkem), opkid, opkdh, h(opkkem), iksI, ekpub, h(ctspk), h(ctopk), ld) in
  let sk = hx_sk(dh1, dh2, dh3, dh4, ssspk, ssopk, tr) in
  let kid = hx_kid(ld, lk, dh3, ssspk, dh4, ssopk) in
  (* §7.2 initiator: dh_r = SPK_dh_R, kem_r = RPK_kem_R; §7.3 first_msg = Content Handshake(Profile_I, 0, routes_I) *)
  new a[]: bitstring;
  new r3[]: bitstring;
  let a1 = dhsk(s, eph(a)) in
  let dka = kemsk(s, eph(a)) in
  let ct1 = encaps_ct768(rpkkem, kemr(s, r3)) in
  let ss1 = encaps_ss768(rpkkem, kemr(s, r3)) in
  let dht = exp(spkdh, a1) in
  let rk0 = init_rk(sk) in
  let rk1 = rk_rk(rk0, dht, ss1) in
  let cks1 = rk_ck(rk0, dht, ss1) in
  new routes[]: bitstring;
  let rt = (profI, routes) in
  let fm = mkcell(init_hka(sk), cks1, tr, (exp(g, a1), c0, c0, pk768(dka), ct1), (ctHS, rt)) in
  (* §6.5 Inner, inner_ct, Outer, three chunks under K_inv *)
  new nin[]: nonce;
  let outer = (ekpub, spkid, opkid, ctspk, ctopk, nin, caead_seal(kid, nin, (lbl_inner, ld), (iksI, fm))) in
  let kinv = hx_kinv(ld, lk) in
  new iid[]: bitstring;
  new m0[]: nonce;
  new m1[]: nonce;
  new m2[]: nonce;
  event IStart(s, iksI, iksR, b, tr, rt, sk);
  out(c, (m0, caead_seal(kinv, m0, (lbl_initcell, ld), (iid, i0, t3, chunk0(outer)))));
  out(c, (m1, caead_seal(kinv, m1, (lbl_initcell, ld), (iid, i1, t3, chunk1(outer)))));
  out(c, (m2, caead_seal(kinv, m2, (lbl_initcell, ld), (iid, i2, t3, chunk2(outer)))));
  (* H6b: R's first reply, §7.4 step path under nhk_r = NHK_B (hk_r = None) *)
  in(c, (rn: nonce, rhc: bitstring, rbd: bitstring));
  let (dhpk2: G, pn2: bitstring, =c0, ek2: bitstring, ct2: bitstring) = hopen(init_nhkb(sk), rn, (lbl_hdr, tr), rhc) in
  if dhpk2 = spkdh then 0 else                       (* a step must carry a new ratchet key *)
  let ssr2 = decaps768(dka, ct2) in
  let dhr2 = exp(dhpk2, a1) in
  let ckr2 = rk_ck(rk1, dhr2, ssr2) in
  let x = bopen(ck_mk(ckr2), (lbl_body, tr, rn, rhc), rbd) in
  event IConfirm(s, iksI, iksR, tr, sk).

(* Compromise processes (5.); ph: never, ph0 or ph1 *)
let PubI(s: tagt) =
  event PubIKS(s, pI);
  out(c, iks(vk(iksig(s, pI)), exp(g, dhsk(s, kIKI)))).

let RevLT(s: tagt, p: bitstring, k: bitstring, ph: bitstring) =
    (if ph = ph0 then (event RevealLT(s, p); out(c, (iksig(s, p), dhsk(s, k)))))
  | (if ph = ph1 then (phase 1; event RevealLT(s, p); out(c, (iksig(s, p), dhsk(s, k))))).

let RevSPK(s: tagt, ph: bitstring) =
    (if ph = ph0 then (event RevealSPK(s, pR); out(c, (dhsk(s, kSPK), kemsk(s, kSPK), kemsk(s, kRPK)))))
  | (if ph = ph1 then (phase 1; event RevealSPK(s, pR); out(c, (dhsk(s, kSPK), kemsk(s, kSPK), kemsk(s, kRPK))))).

(* The phase-1 DH oracle (4.) *)
let DHO1 = phase 1; ! in(c, (x: G, y: G)); out(c, dh_break1(x, y)).

(* One session (3.): iatt = I also takes invitations from c; pub = PubIKS; the phases of the compromises *)
let Session(s: tagt, iatt: bitstring, pub: bitstring, leak: bitstring, ltR: bitstring, ltI: bitstring,
            spkr: bitstring, ropk: bitstring) =
    ProcR(s, leak, ropk)
  | ! ProcI(s, pinv(s))
  | (if iatt = yes then ! ProcI(s, c))
  | (if pub = yes then PubI(s))
  | RevLT(s, pR, kIKR, ltR)
  | RevLT(s, pI, kIKI, ltI)
  | RevSPK(s, spkr).

process
    (*         s            iatt pub  LeakInv LT(R)  LT(I)  SPK    OPK *)
    Session(hClean,      yes, yes, ph0,   never, never, never, never)
  | Session(hDH,         yes, yes, ph0,   never, never, never, never)
  | Session(hKEM,        yes, yes, ph0,   never, never, never, never)
  | Session(hBoth,       yes, yes, ph0,   never, never, never, never)
  | Session(hId,         no,  no,  never, never, never, never, never)
  | Session(hIdThief,    no,  no,  ph0,   never, never, never, never)
  | Session(hIdLater,    no,  no,  ph1,   ph1,   never, ph1,   never)
  | Session(hIdLaterOPK, no,  no,  ph1,   ph1,   never, ph1,   ph1)
  | Session(hKCI,        yes, yes, ph0,   never, never, ph0,   never)
  | Session(hKCIlt,      yes, yes, ph0,   ph0,   never, never, never)
  | Session(hKCIi,       yes, yes, ph0,   never, ph0,   never, never)
  | Session(hFS,         yes, yes, ph1,   ph1,   ph1,   ph1,   never)
  | Session(hFSOPK,      yes, yes, ph1,   ph1,   ph1,   ph1,   ph1)
  | Session(hFSDH,       yes, yes, ph1,   ph1,   ph1,   ph1,   never)
  | DHO1
