(* SPDX-License-Identifier: AGPL-3.0-or-later *)
(* formal/hx/hKEM.pv — session hKEM of CLAIMS §HX, one file per session (O-18, ADR-046) over the library
   formal/hx.pvl (model, abstractions, devices: its header). Run: proverif -lib formal/hx.pvl formal/hx/hKEM.pv

   Row (formal/hx.pvl 3.): I's inv. pinv · PubIKS yes · LeakInv ph 0 · RevealLT(R) - · RevealLT(I) - · RevealSPK - ·
   RevealOPK - · DHO - · KEMO ph 0 · layers plain (O-17).
   Base file (O-22): no attacker-as-inviter process; the begin-IStart declaration (H5) is in hKEM-auth.pv.
   Queries (RESULT lines in this order; expected per the CLAIMS gate rule):
     no begin event:    H3 (2) true · H11 (4) false
   — 6 RESULT lines.
*)

const hKEM: tagt.

(* KEMO, phase 0 (formal/hx.pvl 4.) *)
reduc forall ek: bitstring, r: bitstring;
        kem_break1024(encaps_ct1024(ek, kemr(hKEM, r))) = encaps_ss1024(ek, kemr(hKEM, r)).
reduc forall ek: bitstring, r: bitstring;
        kem_break768(encaps_ct768(ek, kemr(hKEM, r))) = encaps_ss768(ek, kemr(hKEM, r)).

(* Secrecy assumptions (formal/hx.pvl 7.): the keys this session never reveals, and those it reveals only in
   phase 1 (phase 0) *)
not x: bitstring; attacker(dhsk(hKEM, eph(x))).
not x: bitstring; attacker(kemsk(hKEM, eph(x))).
not attacker(iksig(hKEM, pR)).
not attacker(dhsk(hKEM, kIKR)).
not attacker(iksig(hKEM, pI)).
not attacker(dhsk(hKEM, kIKI)).
not attacker(dhsk(hKEM, kSPK)).
not attacker(kemsk(hKEM, kSPK)).
not attacker(kemsk(hKEM, kRPK)).

(* Queries (CLAIMS.md §HX), ordered by begin event (O-22); IKSPublic of the honest parties:
   iks(vk(iksig(s, pR)), exp(g, dhsk(s, kIKR))) and iks(vk(iksig(s, pI)), exp(g, dhsk(s, kIKI))). *)

query iI: bitstring, iR: bitstring, b: bitstring, tr: bitstring, rt: bitstring, sk: key, ld: bitstring,
      oid: bitstring, s2: tagt;
      (* H3 (i): SK secrecy with the KEM oracle, I side, iks_R honest *)
      event(IStart(hKEM, iI, iks(vk(iksig(hKEM, pR)), exp(g, dhsk(hKEM, kIKR))), b, tr, rt, sk)) && attacker(sk);
      (* H3 (ii): R side, unmatched *)
      event(RAccept(hKEM, iR, iks(vk(iksig(hKEM, pI)), exp(g, dhsk(hKEM, kIKI))), ld, oid, tr, rt, sk))
        && attacker(sk);
      (* H11: reachability sanity: IStart, BundleSigned, the honest pair, IConfirm — IStart *)
      event(IStart(hKEM, iks(vk(iksig(hKEM, pI)), exp(g, dhsk(hKEM, kIKI))),
                   iks(vk(iksig(hKEM, pR)), exp(g, dhsk(hKEM, kIKR))), b, tr, rt, sk));
      (* H11: BundleSigned *)
      event(BundleSigned(hKEM, iR, b));
      (* H11: the honest pair *)
      event(RAccept(hKEM, iR, iks(vk(iksig(hKEM, pI)), exp(g, dhsk(hKEM, kIKI))), ld, oid, tr, rt, sk))
        && event(IStart(hKEM, iks(vk(iksig(hKEM, pI)), exp(g, dhsk(hKEM, kIKI))), iR, b, tr, rt, sk));
      (* H11: IConfirm *)
      event(IConfirm(hKEM, iks(vk(iksig(hKEM, pI)), exp(g, dhsk(hKEM, kIKI))),
                     iks(vk(iksig(hKEM, pR)), exp(g, dhsk(hKEM, kIKR))), tr, sk)).

(* One invitation j issued by R (formal/hx.pvl 1.): OPK_j, bundle, InvitationV1 (to I on pinv), blob, the one
   acceptance attempt (O-13), and this session's compromise of the invitation *)
let Invitation(s: tagt) =
  new o[]: bitstring;
  new ld[]: bitstring;
  new lk[]: key;
  new opkid[]: bitstring;
  let b = bundle(s, opkid, o) in
  event BundleSigned(s, riks(s), b);
  event InvIssued(s, riks(s), ld, opkid);
  out(c, ld);
  out(c, BlobP(s, ld, b));
  (
    AcceptP(s, ld, lk, opkid, o)
  | out(pinv(s), (ld, lk, fp(riks(s))))
  | Leak(s, ld, lk)
  ).

process
    out(c, riks(hKEM))
  | ! Invitation(hKEM)
  | ! ProcIP(hKEM, pinv(hKEM))
  | PubI(hKEM)
