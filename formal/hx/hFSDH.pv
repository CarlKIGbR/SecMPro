(* SPDX-License-Identifier: AGPL-3.0-or-later *)
(* formal/hx/hFSDH.pv — session hFSDH of CLAIMS §HX, one file per session (O-18, ADR-046) over the library
   formal/hx.pvl (model, abstractions, devices: its header). Run: proverif -lib formal/hx.pvl formal/hx/hFSDH.pv

   Row (formal/hx.pvl 3.): I's inv. pinv · PubIKS yes · LeakInv ph 1 · RevealLT(R) ph 1 · RevealLT(I) ph 1 · RevealSPK ph 1 ·
   RevealOPK - · DHO ph 1 · KEMO - · layers sealed (O-17).
   Queries (RESULT lines in this order; expected per the CLAIMS gate rule):
     no begin event:    H11 (4) false · H12c (2) true
   — 6 RESULT lines.
*)

const hFSDH: tagt.

(* DHO, phase 1 only: private, offered by the process DHO1 from phase 1 on (formal/hx.pvl 4.) *)
reduc forall x: bitstring, y: bitstring;
        dh_break1(exp(g, dhsk(hFSDH, x)), exp(g, dhsk(hFSDH, y))) = exp(exp(g, dhsk(hFSDH, x)), dhsk(hFSDH, y))
      [private].

(* Secrecy assumptions (formal/hx.pvl 7.): the keys this session never reveals, and those it reveals only in
   phase 1 (phase 0) *)
not x: bitstring; attacker(dhsk(hFSDH, eph(x))).
not x: bitstring; attacker(kemsk(hFSDH, eph(x))).
not attacker(iksig(hFSDH, pR)) phase 0.
not attacker(dhsk(hFSDH, kIKR)) phase 0.
not attacker(iksig(hFSDH, pI)) phase 0.
not attacker(dhsk(hFSDH, kIKI)) phase 0.
not attacker(dhsk(hFSDH, kSPK)) phase 0.
not attacker(kemsk(hFSDH, kSPK)) phase 0.
not attacker(kemsk(hFSDH, kRPK)) phase 0.

(* Queries (CLAIMS.md §HX), grouped by begin event (O-19); IKSPublic of the honest parties:
   iks(vk(iksig(s, pR)), exp(g, dhsk(s, kIKR))) and iks(vk(iksig(s, pI)), exp(g, dhsk(s, kIKI))). *)

query iI: bitstring, iR: bitstring, b: bitstring, tr: bitstring, rt: bitstring, sk: key, ld: bitstring,
      oid: bitstring, s2: tagt;
      (* H11: reachability sanity: IStart, BundleSigned, the honest pair, IConfirm — IStart *)
      event(IStart(hFSDH, iks(vk(iksig(hFSDH, pI)), exp(g, dhsk(hFSDH, kIKI))),
                   iks(vk(iksig(hFSDH, pR)), exp(g, dhsk(hFSDH, kIKR))), b, tr, rt, sk));
      (* H11: BundleSigned *)
      event(BundleSigned(hFSDH, iR, b));
      (* H11: the honest pair *)
      event(RAccept(hFSDH, iR, iks(vk(iksig(hFSDH, pI)), exp(g, dhsk(hFSDH, kIKI))), ld, oid, tr, rt, sk))
        && event(IStart(hFSDH, iks(vk(iksig(hFSDH, pI)), exp(g, dhsk(hFSDH, kIKI))), iR, b, tr, rt, sk));
      (* H11: IConfirm *)
      event(IConfirm(hFSDH, iks(vk(iksig(hFSDH, pI)), exp(g, dhsk(hFSDH, kIKI))),
                     iks(vk(iksig(hFSDH, pR)), exp(g, dhsk(hFSDH, kIKR))), tr, sk));
      (* H12c (i): FS under a later classical break, I side, iks_R honest *)
      event(IStart(hFSDH, iI, iks(vk(iksig(hFSDH, pR)), exp(g, dhsk(hFSDH, kIKR))), b, tr, rt, sk)) && attacker(sk);
      (* H12c (ii): R side *)
      event(RAccept(hFSDH, iR, iks(vk(iksig(hFSDH, pI)), exp(g, dhsk(hFSDH, kIKI))), ld, oid, tr, rt, sk))
        && attacker(sk).

(* One invitation j issued by R (formal/hx.pvl 1.): OPK_j, bundle, InvitationV1, blob, the one acceptance
   attempt (O-13), and this session's compromise of the invitation *)
let Invitation(s: tagt) =
  new o[]: bitstring;
  new ld[]: bitstring;
  new lk[]: key;
  new opkid[]: bitstring;
  let b = bundle(s, opkid, o) in
  event BundleSigned(s, riks(s), b);
  event InvIssued(s, riks(s), ld, opkid);
  out(c, ld);
  out(c, BlobS(s, ld, lk, b));
  (
    AcceptS(s, ld, lk, opkid, o)
  | out(pinv(s), (ld, lk, fp(riks(s))))
  | (phase 1; Leak(s, ld, lk))
  ).

process
    out(c, riks(hFSDH))
  | ! Invitation(hFSDH)
  | ! ProcIS(hFSDH, pinv(hFSDH))
  | PubI(hFSDH)
  | (phase 1; RevLT(hFSDH, pR, kIKR))
  | (phase 1; RevLT(hFSDH, pI, kIKI))
  | (phase 1; RevSPK(hFSDH))
  | (phase 1; ! in(c, (x: G, y: G)); out(c, dh_break1(x, y)))
