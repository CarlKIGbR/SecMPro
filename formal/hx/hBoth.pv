(* SPDX-License-Identifier: AGPL-3.0-or-later *)
(* formal/hx/hBoth.pv — session hBoth of CLAIMS §HX, one file per session (O-18, ADR-046) over the library
   formal/hx.pvl (model, abstractions, devices: its header). Run: proverif -lib formal/hx.pvl formal/hx/hBoth.pv

   Row (formal/hx.pvl 3.): I's inv. pinv · PubIKS yes · LeakInv ph 0 · RevealLT(R) - · RevealLT(I) - · RevealSPK - ·
   RevealOPK - · DHO ph 0 · KEMO ph 0 · layers plain (O-17).
   Queries (RESULT lines in this order; expected per the CLAIMS gate rule):
     no begin event:    H4 (1) false · H11 (4) false
   — 5 RESULT lines.
*)

const hBoth: tagt.

(* DHO, phase 0 (formal/hx.pvl 4.) *)
reduc forall x: bitstring, y: bitstring;
        dh_break(exp(g, dhsk(hBoth, x)), exp(g, dhsk(hBoth, y))) = exp(exp(g, dhsk(hBoth, x)), dhsk(hBoth, y)).

(* KEMO, phase 0 (formal/hx.pvl 4.) *)
reduc forall ek: bitstring, r: bitstring;
        kem_break1024(encaps_ct1024(ek, kemr(hBoth, r))) = encaps_ss1024(ek, kemr(hBoth, r)).
reduc forall ek: bitstring, r: bitstring;
        kem_break768(encaps_ct768(ek, kemr(hBoth, r))) = encaps_ss768(ek, kemr(hBoth, r)).

(* Secrecy assumptions (formal/hx.pvl 7.): the keys this session never reveals, and those it reveals only in
   phase 1 (phase 0) *)
not x: bitstring; attacker(dhsk(hBoth, eph(x))).
not x: bitstring; attacker(kemsk(hBoth, eph(x))).
not attacker(iksig(hBoth, pR)).
not attacker(dhsk(hBoth, kIKR)).
not attacker(iksig(hBoth, pI)).
not attacker(dhsk(hBoth, kIKI)).
not attacker(dhsk(hBoth, kSPK)).
not attacker(kemsk(hBoth, kSPK)).
not attacker(kemsk(hBoth, kRPK)).

(* Queries (CLAIMS.md §HX), grouped by begin event (O-19); IKSPublic of the honest parties:
   iks(vk(iksig(s, pR)), exp(g, dhsk(s, kIKR))) and iks(vk(iksig(s, pI)), exp(g, dhsk(s, kIKI))). *)

query iI: bitstring, iR: bitstring, b: bitstring, tr: bitstring, rt: bitstring, sk: key, ld: bitstring,
      oid: bitstring, s2: tagt;
      (* H4: sanity, both breaks defeat SK secrecy; expected false *)
      event(IStart(hBoth, iI, iks(vk(iksig(hBoth, pR)), exp(g, dhsk(hBoth, kIKR))), b, tr, rt, sk)) && attacker(sk);
      (* H11: reachability sanity: IStart, BundleSigned, the honest pair, IConfirm — IStart *)
      event(IStart(hBoth, iks(vk(iksig(hBoth, pI)), exp(g, dhsk(hBoth, kIKI))),
                   iks(vk(iksig(hBoth, pR)), exp(g, dhsk(hBoth, kIKR))), b, tr, rt, sk));
      (* H11: BundleSigned *)
      event(BundleSigned(hBoth, iR, b));
      (* H11: the honest pair *)
      event(RAccept(hBoth, iR, iks(vk(iksig(hBoth, pI)), exp(g, dhsk(hBoth, kIKI))), ld, oid, tr, rt, sk))
        && event(IStart(hBoth, iks(vk(iksig(hBoth, pI)), exp(g, dhsk(hBoth, kIKI))), iR, b, tr, rt, sk));
      (* H11: IConfirm *)
      event(IConfirm(hBoth, iks(vk(iksig(hBoth, pI)), exp(g, dhsk(hBoth, kIKI))),
                     iks(vk(iksig(hBoth, pR)), exp(g, dhsk(hBoth, kIKR))), tr, sk)).

(* One invitation j issued by R (formal/hx.pvl 1.): OPK_j, bundle, InvitationV1 (to I on pinv), blob, the one
   acceptance attempt (O-13), and this session's compromise of the invitation *)
let Invitation(s: tagt) =
  new o[]: bitstring;
  new ld[]: bitstring;
  new lk[]: key;
  new opkid[]: bitstring;
  let b = bundle(s, opkid, o) in
  event BundleSigned(s, riks(s), b);
  event InvIssued(s, riks(s), ld, opkid);
  out(c, ld);
  out(c, BlobP(s, ld, b));
  (
    AcceptP(s, ld, lk, opkid, o)
  | out(pinv(s), (ld, lk, fp(riks(s))))
  | Leak(s, ld, lk)
  ).

process
    out(c, riks(hBoth))
  | ! Invitation(hBoth)
  | ! ProcIP(hBoth, pinv(hBoth))
  | PubI(hBoth)
