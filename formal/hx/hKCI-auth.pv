(* SPDX-License-Identifier: AGPL-3.0-or-later *)
(* formal/hx/hKCI-auth.pv — session hKCI of CLAIMS §HX, its begin-IStart declaration (O-22) over the library
   formal/hx.pvl (model, abstractions, devices: its header). Run: proverif -lib formal/hx.pvl formal/hx/hKCI-auth.pv

   Row (formal/hx.pvl 3.): as hKCI.pv plus the attacker as inviter: I on c with event IStartA (ProcIPA, O-20,
   O-21), only on bundles that verify under IK_sig_R (O-23).
   Queries (RESULT lines in this order; expected per the CLAIMS gate rule):
     begin IStart:      H9 (1) false
   — 1 RESULT line. The other declarations of the session are in hKCI.pv.
*)

const hKCI: tagt.

(* Secrecy assumptions (formal/hx.pvl 7.): the keys this session never reveals, and those it reveals only in
   phase 1 (phase 0) *)
not x: bitstring; attacker(dhsk(hKCI, eph(x))).
not x: bitstring; attacker(kemsk(hKCI, eph(x))).
not attacker(iksig(hKCI, pR)).
not attacker(dhsk(hKCI, kIKR)).
not attacker(iksig(hKCI, pI)).
not attacker(dhsk(hKCI, kIKI)).

(* Queries (CLAIMS.md §HX), ordered by begin event (O-22); IKSPublic of the honest parties:
   iks(vk(iksig(s, pR)), exp(g, dhsk(s, kIKR))) and iks(vk(iksig(s, pI)), exp(g, dhsk(s, kIKI))). *)

query iI: bitstring, iR: bitstring, b: bitstring, tr: bitstring, rt: bitstring, sk: key, ld: bitstring,
      oid: bitstring, s2: tagt;
      (* H9: expected false — KCI with R's signed-prekey secret: H5's correspondence *)
      inj-event(RAccept(hKCI, iR, iks(vk(iksig(hKCI, pI)), exp(g, dhsk(hKCI, kIKI))), ld, oid, tr, rt, sk))
        ==> inj-event(IStart(hKCI, iks(vk(iksig(hKCI, pI)), exp(g, dhsk(hKCI, kIKI))), iR, b, tr, rt, sk)).

(* One invitation j issued by R (formal/hx.pvl 1.): OPK_j, bundle, InvitationV1 (to I on pinv), blob, the one
   acceptance attempt (O-13), and this session's compromise of the invitation *)
let Invitation(s: tagt) =
  new o[]: bitstring;
  new ld[]: bitstring;
  new lk[]: key;
  new opkid[]: bitstring;
  let b = bundle(s, opkid, o) in
  event BundleSigned(s, riks(s), b);
  event InvIssued(s, riks(s), ld, opkid);
  out(c, ld);
  out(c, BlobP(s, ld, b));
  (
    AcceptP(s, ld, lk, opkid, o)
  | out(pinv(s), (ld, lk, fp(riks(s))))
  | Leak(s, ld, lk)
  ).

process
    out(c, riks(hKCI))
  | ! Invitation(hKCI)
  | ! ProcIP(hKCI, pinv(hKCI))
  | ! ProcIPA(hKCI, c)
  | PubI(hKCI)
  | RevSPK(hKCI)
