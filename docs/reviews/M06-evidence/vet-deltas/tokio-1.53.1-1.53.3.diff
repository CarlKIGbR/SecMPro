+#[tokio::test]
+async fn trace_with_join_all_small() {
+    // Control: small join_all inputs poll every unfinished child directly.
+    let (receivers, make_ready) = channels(2);
+    let results = trace_after_wake(join_all(receivers), make_ready).await;
